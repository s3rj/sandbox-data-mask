<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="sandbox-data-mask"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Apex rules for sandbox-data-mask.</description>

    <rule ref="category/apex/bestpractices.xml">
        <!-- Tests run as the deploying admin on purpose; there is no second persona to model. -->
        <exclude name="ApexUnitTestClassShouldHaveRunAs"/>
    </rule>
    <rule ref="category/apex/errorprone.xml"/>
    <rule ref="category/apex/performance.xml"/>
    <rule ref="category/apex/security.xml">
        <!-- The point of the tool is to rewrite every record of the configured objects. Object and field
             updateability are checked against the describe in MaskPlan.validateStep() before any batch is
             queued, and the Mask Run and Mask Settings DML check CRUD explicitly; field-level security is
             deliberately not applied to the masked fields. -->
        <exclude name="ApexCRUDViolation"/>
    </rule>
</ruleset>
